# BudgetBook v0.2.0 — Firebase 환경 설정
#
# 사용법:
# 1. 이 파일을 `.env`로 복사: cp .env.example .env
# 2. 마님 Google 계정으로 Firebase Console에서 받은 firebaseConfig 값으로 채우기
# 3. 앱 재시작
#
# ⚠️ `.env` 파일은 `.gitignore`에 등록되어 있어 git에 올라가지 않습니다.
# ⚠️ Firebase apiKey는 클라이언트 SDK 키라 노출돼도 안전하지만, 그래도 git에는 안 올림.
# ⚠️ 실제 보안은 Firestore Rules로 가족 화이트리스트 적용.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
